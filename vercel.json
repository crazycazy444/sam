{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/outputs/(.*)", "destination": "/outputs/$1" },
    { "source": "/(.*)", "destination": "/static/$1" }
  ]
}
